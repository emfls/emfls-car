---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GuideDetail from '@/components/GuideDetail.astro';
import { publishedGuides, guideDetails } from '@/data/content';
export function getStaticPaths() { return publishedGuides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const detail = guideDetails.find((item) => item.slug === guide.slug)!;
---
<BaseLayout title={detail.seoTitle} description={detail.description}>
  <section class="page-hero guide-page-hero"><div class="container"><p class="eyebrow">GUIDE / {guide.tag}</p><h1>{detail.title}</h1><p>{detail.lead}</p><a class="guide-back" href="/guides/">← 전체 가이드</a></div></section>
  <section class="section"><div class="container guide-detail-wrap"><GuideDetail detail={detail} /></div></section>
</BaseLayout>
<script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Article', headline: detail.title, description: detail.description, mainEntityOfPage: `${Astro.site?.toString().replace(/\/$/, '') ?? 'https://car.emfls.com'}${Astro.url.pathname}` })} />
