---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatusMetric from '@/components/StatusMetric.astro';
import GuideCard from '@/components/GuideCard.astro';
import ToolCard from '@/components/ToolCard.astro';
import { categories, guides, tools } from '@/data/content';
---
<BaseLayout title="자동차 관리 대시보드">
  <section class="hero"><div class="container hero-grid"><div><p class="eyebrow">VEHICLE LIFE, BETTER MANAGED</p><h1>차량 생활을<br /><em>정확하게 관리하는</em> 법.</h1><p class="hero-copy">자동차 유지관리부터 운전, 타이어, 전기차까지. 필요한 순간 바로 꺼내 보는 자동차 관리 대시보드입니다.</p><div class="hero-actions"><a class="button button-primary" href="/guides/">차량 관리 시작 <span aria-hidden="true">→</span></a><a class="button button-secondary" href="/tools/">자동차 도구 보기</a></div><p class="microcopy">정보를 쌓고, 점검을 놓치지 않도록.</p></div>
    <div class="dashboard" aria-label="예시 차량 상태 대시보드"><div class="dash-head"><span class="dash-label">CAR STATUS / SAMPLE</span><span class="demo-badge">DEMO UI · EXAMPLE</span></div><div class="odometer"><strong>72,450</strong><span>km<br />EXAMPLE</span></div><div class="dash-status"><StatusMetric label="ENGINE OIL" value="정상 범위" status="normal" note="NORMAL" /><StatusMetric label="TIRE" value="점검 권장" status="attention" note="CHECK" /><StatusMetric label="BATTERY" value="정상 범위" status="normal" note="NORMAL" /><StatusMetric label="BRAKE" value="교체 시기 확인" status="warning" note="SOON" /></div><div class="dash-footer"><span>이 화면의 수치는 예시입니다.</span><span>STATUS // READY</span></div></div>
  </div></section>
  <section class="section section-alt"><div class="container"><SectionHeading eyebrow="QUICK TOOLS" title="필요한 계산과 점검을 빠르게." description="도구는 순차적으로 추가됩니다. 현재 카드는 서비스 구조를 보여주는 예시입니다." href="/tools/" linkLabel="도구 전체 보기" /><div class="tools-grid">{tools.map((tool) => <ToolCard tool={tool} />)}</div></div></section>
  <section class="section"><div class="container"><SectionHeading eyebrow="MAINTENANCE GUIDES" title="차량 관리의 기본부터." href="/guides/" /><div class="guide-grid">{guides.slice(0, 5).map((guide) => <GuideCard guide={guide} />)}</div></div></section>
  <section class="section section-alt"><div class="container"><SectionHeading eyebrow="EXPLORE BY SYSTEM" title="차량의 모든 영역을 한곳에서." /><div class="categories">{categories.map((category) => <a class="category-chip" href={`/guides/category/${category.slug}/`}>{category.label}<span>↗</span></a>)}</div></div></section>
  <section class="section"><div class="container cta-panel"><div><p class="eyebrow">VEHICLE MAINTENANCE</p><h2>내 차의 다음 점검을 놓치지 않도록.</h2><p>주행거리와 최근 관리 상태를 바탕으로 점검 우선순위를 확인해 보세요.</p></div><a class="button button-secondary" href="/tools/maintenance-planner/">플래너 열기 <span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
