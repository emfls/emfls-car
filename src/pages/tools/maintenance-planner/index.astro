---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ToolCard from '@/components/ToolCard.astro';
import { tools } from '@/data/content';
const relatedTools = tools.filter((tool) => !['fuel-economy', 'maintenance-planner'].includes(tool.slug));
---
<BaseLayout title="차량 유지관리 플래너" description="현재 주행거리와 엔진오일, 타이어, 배터리, 브레이크 상태를 입력해 점검 우선순위를 확인하세요.">
  <section class="page-hero planner-hero"><div class="container"><p class="eyebrow">AUTOMOTIVE TOOL / MAINTENANCE</p><h1>차량 유지관리 플래너</h1><p>내 차의 현재 관리 상태를 간단히 입력하고, 어떤 항목을 먼저 확인할지 Dashboard 형태로 살펴보세요.</p></div></section>
  <section class="section planner-section"><div class="container planner-layout">
    <form class="planner-form" id="maintenance-planner" novalidate><div class="calculator-form-head"><div><p class="eyebrow">INPUT / VEHICLE STATUS</p><h2>차량 정보를 입력하세요.</h2></div><span class="demo-badge">NO DATA SAVED</span></div>
      <div class="field-grid planner-fields"><div class="field field-wide"><label for="current-mileage">현재 주행거리 <span>(km)</span></label><input id="current-mileage" name="currentMileage" type="number" inputmode="numeric" min="0" step="1" placeholder="예: 72000" aria-describedby="current-mileage-error" /><p class="field-error" id="current-mileage-error" role="alert"></p></div><div class="field field-wide"><label for="oil-mileage">마지막 엔진오일 교체 당시 주행거리 <span>(km, 모르면 비워두기)</span></label><input id="oil-mileage" name="oilMileage" type="number" inputmode="numeric" min="0" step="1" placeholder="예: 65000" aria-describedby="oil-mileage-error" /><p class="field-error" id="oil-mileage-error" role="alert"></p></div>
        <fieldset class="choice-field"><legend>타이어 상태</legend><label><input type="radio" name="tireStatus" value="recent" checked /> <span>최근 점검함</span></label><label><input type="radio" name="tireStatus" value="old" /> <span>점검 시점이 오래됨</span></label><label><input type="radio" name="tireStatus" value="unknown" /> <span>모름</span></label></fieldset>
        <fieldset class="choice-field"><legend>배터리 상태</legend><label><input type="radio" name="batteryStatus" value="recent" checked /> <span>최근 점검/교체함</span></label><label><input type="radio" name="batteryStatus" value="old" /> <span>사용 기간이 오래된 것 같음</span></label><label><input type="radio" name="batteryStatus" value="weak" /> <span>시동이 약해진 느낌</span></label><label><input type="radio" name="batteryStatus" value="unknown" /> <span>모름</span></label></fieldset>
        <fieldset class="choice-field"><legend>브레이크 상태</legend><label><input type="radio" name="brakeStatus" value="none" checked /> <span>이상 없음</span></label><label><input type="radio" name="brakeStatus" value="noise" /> <span>소음이 있음</span></label><label><input type="radio" name="brakeStatus" value="feel" /> <span>제동감이 달라짐</span></label><label><input type="radio" name="brakeStatus" value="unknown" /> <span>모름</span></label></fieldset>
      </div><button class="button button-primary planner-submit" type="submit">관리 상태 확인 <span aria-hidden="true">→</span></button><button class="button button-secondary planner-reset" id="planner-reset" type="button">입력 초기화</button><p class="calculator-note">입력한 정보는 저장되거나 서버로 전송되지 않습니다.</p>
    </form>
    <section class="planner-results" aria-labelledby="planner-results-title" aria-live="polite"><div class="calculator-form-head"><div><p class="eyebrow">VEHICLE MAINTENANCE STATUS</p><h2 id="planner-results-title">점검 우선순위</h2></div><span class="result-state" id="planner-state">WAITING</span></div><p class="planner-summary" id="planner-summary">차량 정보를 입력하면 확인이 필요한 항목이 여기에 표시됩니다.</p><div class="maintenance-list" id="maintenance-results"></div><div class="planner-safety" id="planner-safety" hidden><strong>SAFETY NOTE</strong><p>브레이크는 안전과 직접 관련됩니다. 소음이나 제동감 변화가 있으면 계속 운행할지 스스로 단정하지 말고 전문 정비 점검을 권장합니다.</p></div><p class="planner-disclaimer">입력한 정보에 기반한 관리 참고 결과이며 차량 진단을 대신하지 않습니다.</p></section>
  </div></section>
  <section class="section section-alt"><div class="container prose planner-copy"><SectionHeading eyebrow="HOW TO USE" title="플래너 사용 방법" /><h3>차량 유지관리 플래너란?</h3><p>현재 주행거리와 기본적인 관리 상태를 바탕으로 어떤 항목을 먼저 확인할지 정리하는 참고 도구입니다. 정비 시점을 예측하거나 차량을 진단하지 않습니다.</p><h3>결과를 해석하는 방법</h3><p><strong>ATTENTION</strong>은 안전과 관련해 우선 확인할 신호, <strong>CHECK</strong>는 점검 또는 매뉴얼 확인이 필요한 상태, <strong>OK</strong>는 입력상 특별한 이상이 보고되지 않은 상태입니다.</p><h3>제조사 매뉴얼을 확인해야 하는 이유</h3><p>교체 주기와 권장 기준은 차종, 엔진, 부품, 운행 환경에 따라 달라집니다. 플래너 결과보다 차량 매뉴얼과 실제 점검 결과를 우선하세요.</p></div></section>
  <section class="section"><div class="container prose planner-copy"><SectionHeading eyebrow="FAQ" title="자주 묻는 질문" /><details><summary>플래너 결과가 차량 진단 결과인가요?</summary><p>아닙니다. 사용자가 입력한 상태를 기준으로 확인 우선순위를 보여주는 참고 결과입니다. 이상이 있으면 전문가 점검이 필요합니다.</p></details><details><summary>엔진오일 주행거리가 많으면 자동으로 교체해야 하나요?</summary><p>플래너는 마지막 교체 이후 주행거리만 계산합니다. 차량별 교체 주기는 제조사 매뉴얼을 확인해야 하며, 특정 숫자로 교체를 단정하지 않습니다.</p></details><details><summary>입력한 차량 정보가 저장되나요?</summary><p>아니요. 이번 MVP는 브라우저에서만 계산하며 LocalStorage, Cookie, 계정, 서버 전송을 사용하지 않습니다.</p></details><details><summary>브레이크에 소음이 있으면 계속 운전해도 되나요?</summary><p>소음의 원인과 위험도는 차량 상태에 따라 다릅니다. 제동감 변화나 이상 증상이 있으면 계속 운행 여부를 스스로 판단하지 말고 안전을 우선해 전문가에게 점검을 요청하세요.</p></details></div></section>
  <section class="section section-alt"><div class="container"><SectionHeading eyebrow="RELATED TOOLS" title="다른 자동차 도구" href="/tools/" linkLabel="도구 전체 보기" /><div class="tools-grid">{relatedTools.map((tool) => <ToolCard tool={tool} />)}</div></div></section>
</BaseLayout>

<script is:inline>
  const plannerForm = document.querySelector('#maintenance-planner');
  const resultBox = document.querySelector('#maintenance-results');
  const summary = document.querySelector('#planner-summary');
  const plannerState = document.querySelector('#planner-state');
  const safety = document.querySelector('#planner-safety');
  const currentInput = document.querySelector('#current-mileage');
  const oilInput = document.querySelector('#oil-mileage');
  const statusValue = (name) => plannerForm?.querySelector(`input[name="${name}"]:checked`)?.value;
  const format = (value) => Number(value).toLocaleString('ko-KR');
  const getValues = () => ({ currentMileage: currentInput?.value, oilMileage: oilInput?.value, tireStatus: statusValue('tireStatus'), batteryStatus: statusValue('batteryStatus'), brakeStatus: statusValue('brakeStatus') });
  const validate = (values) => { const errors = {}; const current = Number(values.currentMileage); const oil = Number(values.oilMileage); if (!Number.isFinite(current)) errors.currentMileage = '현재 주행거리를 숫자로 입력해 주세요.'; else if (current <= 0) errors.currentMileage = '현재 주행거리는 0보다 커야 합니다.'; else if (current > 10000000) errors.currentMileage = '현재 주행거리는 10,000,000km 이하로 입력해 주세요.'; if (values.oilMileage !== '') { if (!Number.isFinite(oil)) errors.oilMileage = '엔진오일 교체 주행거리를 숫자로 입력해 주세요.'; else if (oil < 0) errors.oilMileage = '엔진오일 교체 주행거리는 0 이상이어야 합니다.'; else if (oil > 10000000) errors.oilMileage = '엔진오일 교체 주행거리는 10,000,000km 이하로 입력해 주세요.'; else if (Number.isFinite(current) && oil > current) errors.oilMileage = '엔진오일 교체 주행거리는 현재 주행거리보다 클 수 없습니다.'; } return errors; };
  const buildPlan = (values) => { const current = Number(values.currentMileage); const oil = values.oilMileage === '' ? null : Number(values.oilMileage); const oilDistance = oil === null ? null : current - oil; const items = [{ key: 'engineOil', label: 'ENGINE OIL', status: oil === null ? 'CHECK' : oilDistance >= 10000 ? 'CHECK' : 'OK', reason: oil === null ? '마지막 교체 주행거리를 모르는 상태입니다.' : `${format(oilDistance)}km 주행 · 제조사 매뉴얼과 비교하세요.`, action: '차량별 엔진오일 교체 기준을 매뉴얼에서 확인하세요.', href: '/guides/engine-oil-change-interval/', guide: '엔진오일 교체 주기' }, { key: 'tire', label: 'TIRE', status: values.tireStatus === 'recent' ? 'OK' : 'CHECK', reason: values.tireStatus === 'recent' ? '최근 점검한 상태입니다.' : '공기압 점검 시점을 확인해야 합니다.', action: '냉간 상태에서 네 바퀴 공기압을 확인하세요.', href: '/guides/tire-pressure/', guide: '타이어 공기압 확인' }, { key: 'battery', label: 'BATTERY', status: values.batteryStatus === 'recent' ? 'OK' : values.batteryStatus === 'weak' ? 'ATTENTION' : 'CHECK', reason: values.batteryStatus === 'recent' ? '최근 점검 또는 교체했습니다.' : values.batteryStatus === 'weak' ? '시동이 약해진 느낌이 선택되었습니다.' : '배터리 상태를 확인해야 합니다.', action: values.batteryStatus === 'weak' ? '배터리와 충전계통 점검을 권장합니다.' : '배터리 상태 측정을 고려하세요.', href: '/guides/car-battery-replacement/', guide: '배터리 교체 시기' }, { key: 'brake', label: 'BRAKE', status: values.brakeStatus === 'none' ? 'OK' : values.brakeStatus === 'noise' || values.brakeStatus === 'feel' ? 'ATTENTION' : 'CHECK', reason: values.brakeStatus === 'none' ? '보고된 이상이 없습니다.' : values.brakeStatus === 'noise' ? '브레이크 소음이 선택되었습니다.' : values.brakeStatus === 'feel' ? '제동감 변화가 선택되었습니다.' : '브레이크 상태를 확인해야 합니다.', action: values.brakeStatus === 'none' ? '다음 정기 점검 때 마모 상태를 확인하세요.' : '안전을 위해 전문 정비 점검을 권장합니다.', href: '/guides/brake-pad-replacement/', guide: '브레이크 패드 교체 시기' }]; const rank = { ATTENTION: 0, CHECK: 1, SOON: 2, OK: 3 }; return items.sort((a,b) => rank[a.status] - rank[b.status]); };
  const render = (items) => { resultBox.innerHTML = items.map((item) => `<article class="maintenance-card status-${item.status.toLowerCase()}"><div class="maintenance-card-top"><span class="maintenance-label">${item.label}</span><strong>${item.status}</strong></div><p>${item.reason}</p><small>${item.action}</small><a href="${item.href}">${item.guide} <span aria-hidden="true">→</span></a></article>`).join(''); const count = items.filter((item) => item.status !== 'OK').length; summary.textContent = count ? `현재 확인이 필요한 항목 ${count}개` : '현재 입력 기준으로 우선 확인이 필요한 항목이 없습니다.'; plannerState.textContent = count ? 'CHECK ITEMS' : 'ALL CLEAR'; safety.hidden = !items.some((item) => item.key === 'brake' && item.status === 'ATTENTION'); };
  plannerForm?.addEventListener('submit', (event) => { event.preventDefault(); const values = getValues(); const errors = validate(values); document.querySelector('#current-mileage-error').textContent = errors.currentMileage || ''; document.querySelector('#oil-mileage-error').textContent = errors.oilMileage || ''; currentInput.setAttribute('aria-invalid', errors.currentMileage ? 'true' : 'false'); oilInput.setAttribute('aria-invalid', errors.oilMileage ? 'true' : 'false'); if (Object.keys(errors).length) { plannerState.textContent = 'CHECK INPUT'; summary.textContent = '입력값을 확인한 뒤 다시 계산해 주세요.'; resultBox.innerHTML = ''; safety.hidden = true; return; } render(buildPlan(values)); });
  document.querySelector('#planner-reset')?.addEventListener('click', () => { plannerForm.reset(); document.querySelector('#current-mileage-error').textContent = ''; document.querySelector('#oil-mileage-error').textContent = ''; currentInput.setAttribute('aria-invalid', 'false'); oilInput.setAttribute('aria-invalid', 'false'); plannerState.textContent = 'WAITING'; summary.textContent = '차량 정보를 입력하면 확인이 필요한 항목이 여기에 표시됩니다.'; resultBox.innerHTML = ''; safety.hidden = true; });
</script>
