---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ToolCard from '@/components/ToolCard.astro';
import { tools } from '@/data/content';
const relatedTools = tools.filter((tool) => tool.slug !== 'fuel-economy');
---
<BaseLayout title="연비 계산기 · 주유비 계산기" description="주행거리, 연료량, 연료 단가를 입력해 연비와 주유비를 바로 계산하세요.">
  <section class="page-hero calculator-hero"><div class="container"><p class="eyebrow">AUTOMOTIVE TOOL / FUEL ECONOMY</p><h1>연비·주유비 계산기</h1><p>주행거리와 사용한 연료량, 연료 단가를 입력하면 실제 주행 연비와 예상 비용을 계산합니다.</p></div></section>
  <section class="section calculator-section"><div class="container calculator-layout">
    <form class="calculator-form" id="fuel-calculator" novalidate>
      <div class="calculator-form-head"><div><p class="eyebrow">INPUT / YOUR TRIP</p><h2>주행 정보를 입력하세요.</h2></div><span class="demo-badge">NO DATA SAVED</span></div>
      <div class="field-grid">
        <div class="field"><label for="distance">주행거리 <span>(km)</span></label><input id="distance" name="distance" type="number" inputmode="decimal" min="0" step="any" placeholder="예: 600" aria-describedby="distance-error" /><p class="field-error" id="distance-error" role="alert"></p></div>
        <div class="field"><label for="fuel">사용한 연료량 <span>(L)</span></label><input id="fuel" name="fuel" type="number" inputmode="decimal" min="0" step="any" placeholder="예: 45" aria-describedby="fuel-error" /><p class="field-error" id="fuel-error" role="alert"></p></div>
        <div class="field field-wide"><label for="unit-price">연료 단가 <span>(원/L)</span></label><input id="unit-price" name="unitPrice" type="number" inputmode="numeric" min="0" step="1" placeholder="예: 1650" aria-describedby="unit-price-error" /><p class="field-error" id="unit-price-error" role="alert"></p></div>
      </div>
      <button class="button button-primary calculator-submit" type="submit">연비와 주유비 계산 <span aria-hidden="true">→</span></button>
      <p class="calculator-note">입력한 값은 이 페이지에서만 계산에 사용되며 저장되지 않습니다.</p>
    </form>
    <section class="results-panel" aria-labelledby="results-title" aria-live="polite"><div class="calculator-form-head"><div><p class="eyebrow">OUTPUT / RESULT</p><h2 id="results-title">계산 결과</h2></div><span class="result-state" id="result-state">WAITING</span></div><div class="metric-grid"><div class="metric-card"><span>연비</span><strong id="fuel-economy-result">—</strong><small>km/L</small></div><div class="metric-card"><span>총 연료비</span><strong id="total-cost-result">—</strong><small>원</small></div><div class="metric-card"><span>1km당 비용</span><strong id="cost-per-km-result">—</strong><small>원/km</small></div><div class="metric-card"><span>100km 예상 비용</span><strong id="cost-per-100km-result">—</strong><small>원</small></div></div><p class="result-message" id="result-message">값을 입력하고 계산하면 결과가 여기에 표시됩니다.</p></section>
  </div></section>
  <section class="section section-alt"><div class="container prose calculator-copy"><SectionHeading eyebrow="HOW IT WORKS" title="연비와 주유비 계산 방법" /><h3>연비 계산 방법</h3><p><strong>연비(km/L) = 주행거리(km) ÷ 사용한 연료량(L)</strong></p><p>같은 양의 연료로 얼마나 먼 거리를 이동했는지 나타내는 값입니다. 숫자가 높을수록 연료 1L로 더 먼 거리를 주행했다는 뜻입니다.</p><h3>주유비 계산 방법</h3><p><strong>총 연료비 = 사용한 연료량(L) × 연료 단가(원/L)</strong></p><p>총 연료비를 주행거리로 나누면 1km당 비용을 구할 수 있고, 여기에 100을 곱하면 100km 주행 예상 비용이 됩니다.</p><h3>계산 예시</h3><div class="example-table"><div><span>주행거리</span><strong>600km</strong></div><div><span>사용 연료량</span><strong>45L</strong></div><div><span>연료 단가</span><strong>1,650원/L</strong></div><div><span>계산 결과</span><strong>13.33km/L · 74,250원</strong></div></div></div></section>
  <section class="section"><div class="container prose calculator-copy"><SectionHeading eyebrow="FAQ" title="자주 묻는 질문" /><details><summary>자동차 연비는 어떻게 계산하나요?</summary><p>주행거리를 사용한 연료량으로 나눕니다. 예를 들어 600km를 45L로 주행했다면 약 13.33km/L입니다.</p></details><details><summary>계기판 평균연비와 실제 연비가 다른 이유는 무엇인가요?</summary><p>계기판의 계산 시점, 주행 환경, 공회전, 타이어 공기압과 측정 오차 등에 따라 차이가 날 수 있습니다. 주유 전후 주행거리와 주유량으로 직접 계산하면 실제 사용량에 가까운 값을 확인할 수 있습니다.</p></details><details><summary>주유비는 어떻게 계산하나요?</summary><p>사용한 연료량에 연료 단가를 곱합니다. 45L를 1,650원/L에 주유하면 총 74,250원입니다.</p></details><details><summary>고속도로와 시내 연비가 다른 이유는 무엇인가요?</summary><p>정차와 출발이 반복되는 시내 주행은 고속도로보다 연료 효율이 낮아지는 경향이 있습니다. 속도, 교통량, 적재량, 날씨도 영향을 줍니다.</p></details></div></section>
  <section class="section section-alt"><div class="container"><SectionHeading eyebrow="RELATED TOOLS" title="다른 자동차 도구" href="/tools/" linkLabel="도구 전체 보기" /><div class="tools-grid">{relatedTools.map((tool) => <ToolCard tool={tool} />)}</div></div></section>
</BaseLayout>

<script is:inline>
  const form = document.querySelector('#fuel-calculator');
  const fields = { distance: document.querySelector('#distance'), fuel: document.querySelector('#fuel'), unitPrice: document.querySelector('#unit-price') };
  const errors = { distance: document.querySelector('#distance-error'), fuel: document.querySelector('#fuel-error'), unitPrice: document.querySelector('#unit-price-error') };
  const labels = { distance: '주행거리', fuel: '사용한 연료량', unitPrice: '연료 단가' };
  const limits = { distance: 10000000, fuel: 10000, unitPrice: 1000000 };
  const particles = { distance: '는', fuel: '은', unitPrice: '는' };
  const formatNumber = (value, maximumFractionDigits = 2) => new Intl.NumberFormat('ko-KR', { maximumFractionDigits }).format(value);
  const validate = (values) => {
    const result = {};
    Object.keys(fields).forEach((key) => {
      const value = Number(values[key]);
      if (!Number.isFinite(value)) result[key] = `${labels[key]}을 숫자로 입력해 주세요.`;
      else if (value <= 0) result[key] = `${labels[key]}${particles[key]} 0보다 커야 합니다.`;
      else if (value > limits[key]) result[key] = `${labels[key]}${particles[key]} ${formatNumber(limits[key], 0)}${key === 'distance' ? 'km' : key === 'fuel' ? 'L' : '원/L'} 이하로 입력해 주세요.`;
    });
    return result;
  };
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const values = Object.fromEntries(Object.entries(fields).map(([key, input]) => [key, input.value]));
    const validationErrors = validate(values);
    Object.keys(fields).forEach((key) => { errors[key].textContent = validationErrors[key] || ''; fields[key].setAttribute('aria-invalid', validationErrors[key] ? 'true' : 'false'); });
    const resultMessage = document.querySelector('#result-message');
    const resultState = document.querySelector('#result-state');
    if (Object.keys(validationErrors).length) { resultState.textContent = 'CHECK INPUT'; resultState.classList.add('has-error'); resultMessage.textContent = '입력값을 확인한 뒤 다시 계산해 주세요.'; return; }
    const distance = Number(values.distance); const fuel = Number(values.fuel); const unitPrice = Number(values.unitPrice); const totalCost = fuel * unitPrice; const costPerKm = totalCost / distance;
    document.querySelector('#fuel-economy-result').textContent = formatNumber(distance / fuel);
    document.querySelector('#total-cost-result').textContent = formatNumber(totalCost, 0);
    document.querySelector('#cost-per-km-result').textContent = formatNumber(costPerKm);
    document.querySelector('#cost-per-100km-result').textContent = formatNumber(costPerKm * 100, 0);
    resultState.textContent = 'CALCULATED'; resultState.classList.remove('has-error'); resultMessage.textContent = '입력한 주행 조건을 기준으로 계산한 결과입니다.';
  });
</script>
