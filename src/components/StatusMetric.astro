---
interface Props { label: string; value: string; status: 'normal' | 'attention' | 'warning'; note: string }
const { label, value, status, note } = Astro.props;
const labels = { normal: 'NORMAL', attention: 'CHECK', warning: 'SOON' };
---
<div class={`status-metric status-${status}`}><div class="status-dot" aria-hidden="true"></div><div><span>{label}</span><strong>{value}</strong></div><small>{labels[status]}<br />{note}</small></div>
